# Copy to .env next to compose.yaml and fill in.

# Image tag: latest (master) or sha-<commit>.
LINKSBLOG_VERSION=latest

# Public URL of the site, e.g. https://links.example.com
LINKSBLOG_BASE_URL=
# openssl rand -hex 32
LINKSBLOG_SESSION_SECRET=
# Time zone of the blog's days, e.g. Europe/Kyiv; UTC when not set
#TZ=

# Sign-in: comma-separated Google accounts and a Google OAuth client whose
# redirect URI is <base URL>/oauth2callback. Leave empty to disable sign-in.
LINKSBLOG_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord bot: token from the Developer Portal (Message Content Intent on) and
# comma-separated user IDs whose messages are accepted. Leave empty to disable.
DISCORD_TOKEN=
DISCORD_ALLOWED_USERS=

# Titles and descriptions of links are fetched from their pages in the
# background; "off" stops it.
#LINKSBLOG_FETCH_METADATA=off
